{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.skillswap.asia"
      }
    },
    "development-mock": {
      "extends": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.skillswap.asia",
        "EXPO_PUBLIC_MOCK_MODE": "1",
        "EXPO_PUBLIC_FORUM_BOT_USER_ID": "bot-user-id"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.skillswap.asia"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.skillswap.asia"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
