# Backend production (spec D7)
EXPO_PUBLIC_API_URL=https://api.skillswap.asia
# AI service: để trống khi chưa deploy (spec R3); khi có thì trỏ tunnel HTTPS hoặc URL production
EXPO_PUBLIC_AI_URL=
# Phải trùng khít GOOGLE_CLIENT_ID backend đang dùng, nếu lệch BE trả OAUTH_VERIFICATION_FAILED
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# userId cua tai khoan bot "SkillSwap AI" tren dien dan; de trong thi khong gan badge AI.
# O che do mock, dat mot gia tri bat ky khac rong (vi du bot-user-id) thi binh luan
# bot trong du lieu gia moi hien badge "AI" — xem features/forum/mocks/handlers.ts.
EXPO_PUBLIC_FORUM_BOT_USER_ID=
# Đặt =1 để bật chế độ mock: MSW chạy trong app, đăng nhập Google được bỏ qua.
# CHỈ có tác dụng ở bản dev — bản phát hành luôn tắt bất kể giá trị nào.
EXPO_PUBLIC_MOCK_MODE=
